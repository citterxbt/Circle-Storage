# Copy this file to .env and fill in what you need.
# Every value below is optional: without Supabase credentials the server falls back to
# the local JSON store in server-db.json.

# PORT: HTTP port the server listens on. Defaults to 3000.
PORT="3000"

# SUPABASE_URL: The URL of your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: The service_role API key, which bypasses row-level security.
# CRITICAL: server-side only. Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# DISABLE_HMR: Set to "true" to turn off Vite HMR and file watching during development.
DISABLE_HMR=""
