# Copy this file to .env and fill in what you need.
# Every value below is optional: without Supabase credentials the server falls back to
# the local JSON store in server-db.json.

# PORT: HTTP port the server listens on. Defaults to 3000.
PORT="3000"

# SESSION_SECRET: HMAC key for wallet sign-in session cookies. At least 32 characters.
# Required when NODE_ENV=production; in development an ephemeral key is generated, which
# means every restart signs everybody out.
SESSION_SECRET=""

# APTOS_FULLNODE_URL: Node API used to verify payments and account auth keys.
APTOS_FULLNODE_URL="https://fullnode.testnet.aptoslabs.com/v1"

# ALLOW_SIMULATED_PAYMENTS: Set to "true" to accept purchases that fail on-chain verification,
# so the flow can be exercised without a funded testnet wallet. Never enable this outside
# local development — it is ignored when NODE_ENV=production.
ALLOW_SIMULATED_PAYMENTS=""

# SUPABASE_URL: The URL of your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: The service_role API key, which bypasses row-level security.
# CRITICAL: server-side only. Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# DISABLE_HMR: Set to "true" to turn off Vite HMR and file watching during development.
DISABLE_HMR=""
