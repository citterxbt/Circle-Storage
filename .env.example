# Copy this file to .env and fill in what you need.
# Every value below is optional except SESSION_SECRET in production.

# PORT: HTTP port the server listens on. Defaults to 3000.
PORT="3000"

# SESSION_SECRET: HMAC key for wallet sign-in session cookies. At least 32 characters.
# Required when NODE_ENV=production. In development an ephemeral key is generated instead,
# which signs everybody out on every restart — set it locally too and save yourself that.
SESSION_SECRET=""

# APP_ORIGIN: The exact browser origin allowed to request wallet sign-in signatures. This
# prevents a valid signature collected by another website from opening a Circle Storage
# session. The development default is http://localhost:<PORT>; set this on every deployment.
APP_ORIGIN="http://localhost:3000"

# ── Shelby ───────────────────────────────────────────────────────────────────────
# Files are stored on Shelby. Blobs are registered on chain by the uploader's own wallet in
# the browser, so no private key belongs here.

# SHELBY_API_KEY: Attributes storage and egress to this project instead of an anonymous
# client. Uploads and downloads still work without it, but are rate-limited.
SHELBY_API_KEY=""

# SHELBY_RPC_URL: Shelby RPC used to transfer and read blob bytes.
SHELBY_RPC_URL="https://api.testnet.shelby.xyz/shelby"

# SHELBY_CONTRACT_ADDRESS: Shelby's deployer, where blob registrations are verified.
SHELBY_CONTRACT_ADDRESS="0x85fdb9a176ab8ef1d9d9c1b60d60b3924f0800ac1de1cc2085fb0b8bb4988e6a"

# ── Aptos ────────────────────────────────────────────────────────────────────────

# APTOS_FULLNODE_URL: Node API used to verify payments, registrations and account auth keys.
APTOS_FULLNODE_URL="https://fullnode.testnet.aptoslabs.com/v1"

# APTOS_CHAIN_ID: Network accepted in wallet sign-in messages. Shelby testnet uses Aptos
# testnet, whose chain ID is 2.
APTOS_CHAIN_ID="2"

# ALLOW_SIMULATED_PAYMENTS: Set to "true" to accept purchases and platform fees that fail
# on-chain verification, so the flow can be exercised without a funded wallet. Never enable
# this outside local development — it is ignored when NODE_ENV=production.
ALLOW_SIMULATED_PAYMENTS=""

# ── Optional database ────────────────────────────────────────────────────────────

# SUPABASE_URL: The URL of your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: The service_role API key, which bypasses row-level security.
# CRITICAL: server-side only. Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Development ──────────────────────────────────────────────────────────────────

# DISABLE_HMR: Set to "true" to turn off Vite HMR and file watching during development.
DISABLE_HMR=""
